programa {
  funcao inicio() {
    inteiro idade = 18
    real altura = 1.75
    cadeia nome = "Felipe"
    caracter letra = 'F'
    logico aprovado = verdadeiro

    escreva("Idade: ", idade, "\n")
    escreva("Altura: ", altura, "\n")
    escreva("Nome: ", nome, "\n")
    escreva("Letra: ", letra, "\n")
    escreva("Aprovado: ", aprovado)
  }
}
