programa {
  inclua biblioteca Matematica
  funcao inicio() {
    real raiz
    real potencia
    raiz = Matematica.raiz(144, 2)
    potencia = Matematica.potencia(2, 8)
    escreva("Raiz quadrada: ", raiz, "\n")
    escreva("Potência: ", potencia)
  }
}
