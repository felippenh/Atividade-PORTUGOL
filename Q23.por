programa {
  funcao inicio() {

    inteiro opcao
    escreva("1 - NOVO JOGO 2 - CARREGAR 3 - SAIR\n")
    escreva("Escolha uma opção: ")
    leia(opcao)

    escolha(opcao){

      caso 1:
        escreva("Opcão Escolhida: 1 - Novo Jogo")
        pare
      caso 2:
        escreva("Opção Escolhida: 2 - Carregar")
        pare
      caso 3:
        escreva("Opção Escolhida: 3 - Sair")
        pare
    }
  }
}
